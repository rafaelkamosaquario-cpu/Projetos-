# Credenciais da sua instância Z-API (https://www.z-api.io/)
# Encontre no painel da Z-API, dentro da sua instância.
ZAPI_INSTANCE_ID=sua_instancia_aqui
ZAPI_TOKEN=seu_token_aqui

# Token de segurança da conta (Client-Token).
# Fica em "Segurança" no painel da sua conta Z-API (não é obrigatório
# se você não tiver ativado essa proteção, mas é recomendado).
ZAPI_CLIENT_TOKEN=seu_client_token_aqui
